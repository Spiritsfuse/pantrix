# Rendered at container start by the nginx image's envsubst entrypoint.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Resolve the API host per request (cached 10s) instead of once at boot, so the
    # UI still starts when the backend Service does not exist yet and follows it if
    # its IP changes. NGINX_LOCAL_RESOLVERS comes from the container's resolv.conf.
    # nginx's resolver ignores search domains: API_UPSTREAM must be a full name
    # (Compose service name, or <svc>.<ns>.svc.cluster.local in Kubernetes).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        # expires (not add_header) so the server-level security headers still apply.
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
